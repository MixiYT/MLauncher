{
  "name": "mlauncher-ai",
  "main": "index.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "vars": { "ALLOWED_MODELS": "openrouter/free" },
  "ratelimits": [
    { "name": "PER_IP", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "TOTAL", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
